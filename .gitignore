# =============================================================================
# Terraform
# =============================================================================

# Local .terraform directories
.terraform/

# .tfstate files (contain sensitive data - NEVER commit)
*.tfstate
*.tfstate.*

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*.tfplan
tfplan.out

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file - committed intentionally, keeps provider versions reproducible
# .terraform.lock.hcl

# =============================================================================
# Azure / Azure CLI
# =============================================================================

.azure/

# =============================================================================
# Environment & secrets
# =============================================================================

.env
.env.*
*.pem
*.key
*.pfx
*credentials*
*secrets*

# =============================================================================
# Claude Code
# =============================================================================

.claude/settings.local.json

# =============================================================================
# OS / editor files
# =============================================================================

.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# =============================================================================
# Logs
# =============================================================================

*.log
crash.log
crash.*.log
